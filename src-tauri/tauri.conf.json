{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADHD Coder",
  "version": "0.1.0",
  "identifier": "dev.adhd.coder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ADHD Coder",
        "width": 280,
        "height": 360,
        "minWidth": 220,
        "minHeight": 200,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": false,
        "shadow": true,
        "x": 1200,
        "y": 80
      },
      {
        "label": "onboarding",
        "url": "onboarding.html",
        "title": "ADHD Coder · 首次设置",
        "width": 480,
        "height": 560,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool"
  }
}
